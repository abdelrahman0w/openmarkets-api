# Copy to `.env` and adjust, anything left out falls back to its default
# The values below are the defaults, or what the local docker compose services use

# App
APP_ENVIRONMENT=DEV
# Defaults to the commit the image is built from
# APP_VERSION=
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true

# Server, read by `bin/entrypoint.sh`
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOOP=uvloop
APP_HTTP=httptools
APP_WORKERS=1

# Read by uvicorn itself
# FORWARDED_ALLOW_IPS=127.0.0.1

# Database, all required but the port
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=openmarkets
DATABASE_PASSWORD=openmarkets
DATABASE_NAME=openmarkets

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_CACHE_TTL_SECONDS=300
REDIS_LIVE_CACHE_SECONDS=30
REDIS_NEWS_CACHE_SECONDS=300
REDIS_NEWS_FRESH_SECONDS=30
REDIS_NEWS_ITEM_CACHE_SECONDS=3600

# Error tracking, off without a dsn
# ERROR_TRACKING_DSN=
ERROR_TRACKING_TRACES_SAMPLE_RATE=0.1
ERROR_TRACKING_LOGS_ENABLED=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TIMEOUT_SECONDS=0.5
RATE_LIMIT_CLIENT_IP_HEADER=CF-Connecting-IP

# CORS, the web origins allowed to call the api from a browser, none by default
# CORS_ORIGINS=["http://localhost:5173"]
CORS_MAX_AGE_SECONDS=600

# EGX market, trading days are python weekdays, monday is 0
EGX_MARKET_TIMEZONE=Africa/Cairo
EGX_MARKET_OPEN_TIME=10:00
EGX_MARKET_CLOSE_TIME=14:30
EGX_MARKET_TRADING_DAYS=[6,0,1,2,3]
EGX_MARKET_SYNC_GRACE_MINUTES=30
EGX_MARKET_USE_LIVE_STATUS=true
EGX_MARKET_STATUS_RETRY_MINUTES=15
EGX_MARKET_STATUS_RETRY_SECONDS=60
EGX_MARKET_LIVE_PRICES_CACHE_SECONDS=10
EGX_MARKET_QUOTE_RETENTION_DAYS=30
EGX_MARKET_REQUEST_TIMEOUT_SECONDS=10

# EGX news, served from storage, which the news sync fills, or fetched from EGX on request
EGX_NEWS_SERVE_FROM_STORAGE=true
EGX_NEWS_SYNC_SESSION_MINUTES=2
EGX_NEWS_SYNC_OFF_SESSION_MINUTES=15
EGX_NEWS_SYNC_DELAY_SECONDS=20
EGX_NEWS_SYNC_PAGE_SIZE=50
EGX_NEWS_SYNC_MAX_PAGES=10
EGX_NEWS_SYNC_PAUSE_SECONDS=3
# the summaries job, it summarizes the items with a pdf attached, from the pdf
EGX_NEWS_SUMMARIZE_BATCH_SIZE=10
# a bit over 60 divided by your tier's requests a minute, the free tier allows 5
EGX_NEWS_SUMMARIZE_PAUSE_SECONDS=15
EGX_NEWS_SUMMARIZE_MAX_ATTEMPTS=3

# EGX indices, the sync stores their levels while the market is open
EGX_INDICES_SYNC_EVERY_MINUTES=5
EGX_INDICES_SYNC_DELAY_SECONDS=40
EGX_INDICES_SYNC_PAUSE_SECONDS=3
EGX_INDICES_POINT_RETENTION_DAYS=30
EGX_INDICES_LEVELS_CACHE_SECONDS=60
EGX_INDICES_SUMMARY_CACHE_SECONDS=900
EGX_INDICES_SUMMARY_FRESH_SECONDS=120
EGX_INDICES_WEIGHTS_CACHE_SECONDS=86400
EGX_INDICES_WEIGHTS_FRESH_SECONDS=3600

# Gemini, from google ai studio, summarizes the news, off without a key, never committed
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_REVISION=2026-05-20
GEMINI_TIMEOUT_SECONDS=90
# your tier's requests a day, from ai studio, the job stops there, keep it under the quota
GEMINI_REQUESTS_PER_DAY=100
# the daily quotas reset at midnight pacific
GEMINI_QUOTA_TIMEZONE=America/Los_Angeles
GEMINI_BUSY_PAUSE_SECONDS=60
# a busy answer in a row doubles the pause, up to this
GEMINI_LONGEST_PAUSE_SECONDS=3600

# Auth, sign in by an emailed code, the market's endpoints need a session
AUTH_REQUIRED=true
# keys the codes' hashes, a long random string, without it one is made per process, never committed
# AUTH_SECRET=
AUTH_SESSION_DAYS=30
AUTH_SESSION_REFRESH_HOURS=24
AUTH_COOKIE_NAME=om_session
# false only over plain http, locally
AUTH_COOKIE_SECURE=true
AUTH_CODE_MINUTES=10
AUTH_CODE_ATTEMPTS=5
AUTH_CODE_COOLDOWN_SECONDS=60
AUTH_CODES_PER_EMAIL_HOUR=5
AUTH_CODES_PER_IP_HOUR=20
AUTH_VERIFICATIONS_PER_IP_HOUR=30

# Resend, sends the codes, without a key a code is logged in DEV, and refused in PROD, never committed
# RESEND_API_KEY=
RESEND_SENDER=Open Markets <no-reply@abdosworld.com>

# Docker builds, the token that reads the private sdk, never committed
# GH_TOKEN=
